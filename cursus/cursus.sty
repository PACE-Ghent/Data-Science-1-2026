% Gemeenschappelijke opmaak voor de cursusteksten van Data Science 1.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cursus}

\RequirePackage[dutch]{babel}
\RequirePackage{lmodern}
\RequirePackage[T1]{fontenc}
\RequirePackage[a4paper,margin=2.3cm,headheight=14pt]{geometry}
\RequirePackage[dvipsnames,table]{xcolor}
\RequirePackage{booktabs,tabularx,array,enumitem,titlesec,fancyhdr,graphicx,needspace}
\RequirePackage{fancyvrb,fvextra}
\RequirePackage[most]{tcolorbox}
\RequirePackage{tikz}
\usetikzlibrary{positioning,arrows.meta,calc}
\RequirePackage[hidelinks]{hyperref}

% Kleuren (zelfde palet als de slides)
\definecolor{pitch}{HTML}{0F3D2E}
\definecolor{accent}{HTML}{EB6834}
\definecolor{muted}{HTML}{5B6B63}
\definecolor{tint}{HTML}{EEF3EF}
\definecolor{lime}{HTML}{C6F432}
\definecolor{forward}{HTML}{2A78D6}
\definecolor{midfielder}{HTML}{EB6834}
\definecolor{defender}{HTML}{1BAF7A}
\definecolor{goalkeeper}{HTML}{EDA100}

\input{pygments.tex}
\AtBeginDocument{\shorthandoff{"}}

\setlength{\parindent}{0pt}
\setlength{\emergencystretch}{3em}
\setlength{\parskip}{0.55em}
\setlist{itemsep=0.2em, topsep=0.3em}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}

\titleformat{\section}{\Large\bfseries\color{pitch}}{\thesection}{0.8em}{}
\titleformat{\subsection}{\large\bfseries\color{pitch}}{\thesubsection}{0.8em}{}
\titleformat{\subsubsection}{\normalsize\bfseries\color{pitch}}{}{0em}{}
\titlespacing*{\section}{0pt}{1.4em}{0.5em}
\titlespacing*{\subsection}{0pt}{1.1em}{0.4em}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
% De auteur komt uit \author{...} in elk labobestand.
\makeatletter
\newcommand{\auteur}{\@author}
\makeatother
\rhead{\small\color{muted}\auteur\quad\textperiodcentered\quad\thepage}

% Code in de lopende tekst
\newcommand{\code}[1]{\texttt{#1}}

% Codeblokken en uitvoer
\fvset{fontsize=\small}
\newtcolorbox{codeblok}{enhanced, breakable, colback=tint, colframe=tint, boxrule=0pt, arc=2mm,
  left=2mm, right=2mm, top=1mm, bottom=1mm, before skip=0.6em, after skip=0.2em}
\newtcolorbox{uitvoer}{enhanced, breakable, colback=white, colframe=muted!35, boxrule=0.4pt, arc=2mm,
  left=2mm, right=2mm, top=1mm, bottom=1mm, before skip=0.2em, after skip=0.7em,
  overlay={\node[anchor=north east, font=\scriptsize\sffamily, text=muted, inner sep=1.5mm] at (frame.north east) {uitvoer};}}

% Kaders
\newtcolorbox{kernidee}[1][Kernidee]{enhanced, breakable, colback=pitch!6, colframe=pitch, boxrule=0pt,
  leftrule=0pt, arc=2mm, fonttitle=\bfseries\sffamily, coltitle=white, colbacktitle=pitch, title=#1,
  before skip=0.8em, after skip=0.8em}
\newtcolorbox{opgelet}[1][Opgelet]{enhanced, breakable, colback=accent!8, colframe=accent, boxrule=0pt,
  arc=2mm, fonttitle=\bfseries\sffamily, coltitle=white, colbacktitle=accent, title=#1,
  before skip=0.8em, after skip=0.8em}
\newtcolorbox{probeer}[1][Probeer zelf]{enhanced, breakable, colback=white, colframe=pitch!50, boxrule=0.6pt,
  arc=2mm, fonttitle=\bfseries\sffamily, coltitle=pitch, colbacktitle=tint, title=#1,
  before skip=0.8em, after skip=0.8em}

% Figuur uit een python-blok
\newcommand{\figuur}[1]{\par\begin{center}\includegraphics[width=0.92\textwidth]{#1}\end{center}\par}

% Titelblok
\newcommand{\labotitel}[3]{%
  \lhead{\small\color{muted}Data Science 1 -- #1}%
  \thispagestyle{empty}%
  \begin{tcolorbox}[enhanced, colback=pitch, colframe=pitch, arc=3mm, left=6mm, right=6mm, top=5mm, bottom=5mm]
    {\color{lime}\sffamily\bfseries #1}\par\vspace{0.4em}
    {\color{white}\Huge\bfseries #2}\par\vspace{0.6em}
    {\color{white}\large #3}\par\vspace{0.8em}
    {\color{lime}\sffamily \auteur}
  \end{tcolorbox}\vspace{0.6em}}
